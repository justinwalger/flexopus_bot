# Copy this file to .env and fill in what you need.
# Every variable below is optional except BACKEND_API_URL.

# --- Required for the Streamlit UI (src/ui/config.py) ---
# The UI calls the FastAPI backend at this URL. There is no default - the UI
# fails to start without it.
BACKEND_API_URL=http://localhost:8000/api

# --- Optional server-side fallback credentials (src/common/config.py) ---
# Only used if a user clicks "Ueberspringen (Server-Zugangsdaten verwenden)"
# instead of entering their own Flexopus/Gemini credentials in the UI form.
# Leave empty to always require the per-session form.
FLEXOPUS_API_TOKEN=
FLEXOPUS_API_URL=
GOOGLE_API_KEY=

# --- Optional: override the default LLM (src/common/config.py) ---
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.1-flash-lite

# --- Optional: LangSmith tracing ---
# Not read by this app's own code - picked up directly by the langchain/
# langsmith SDKs if set.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# --- Optional: only needed to run evals/ locally ---
# DEEPEVAL_RESULTS_FOLDER=./data
